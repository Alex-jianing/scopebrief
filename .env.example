SCOPEBRIEF_DEMO=1
SCOPEBRIEF_SECURE_COOKIE=0

# 本机默认路径。演示为 data/scopebrief.db，团队为 data/team.db。
# SCOPEBRIEF_DB=data/team.db
# 团队用 SCOPEBRIEF_DEMO=0，管理员通过 scopebrief.admin bootstrap 激活。
# 配置 HTTPS 之后把 SCOPEBRIEF_SECURE_COOKIE 设为 1。

# 可选。留空时使用本地证据摘录。服务端读取这些变量。
# SCOPEBRIEF_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# SCOPEBRIEF_MODEL_NAME=qwen2.5:1.5b
# SCOPEBRIEF_MODEL_KEY=
# SCOPEBRIEF_MODEL_TIMEOUT=15
